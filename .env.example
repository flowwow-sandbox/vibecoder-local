# Template variables for vibecoder-local project.
# Rename this file to .env and fill in real values.
#
# .env is in .gitignore -- never commit real values.

# SANDBOX_SLUG -- project name (used for HTML template render in app/).
SANDBOX_SLUG=

# Add your prototype secrets here.

# Example:
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# ADMIN_PASSWORD_SECRET=
